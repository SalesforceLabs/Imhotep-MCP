# Optional environment overrides for the Imhotep MCP server.
# Copy to .env for local development only. Never commit real values.

# Explicit path to a global Imhotep config file (overrides the default lookup).
# Default lookup order: IMHOTEP_CONFIG -> $XDG_CONFIG_HOME/imhotep/config.json -> ~/.imhotep/config.json
# IMHOTEP_CONFIG=/absolute/path/to/config.json
