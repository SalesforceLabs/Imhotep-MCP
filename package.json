{
  "name": "imhotep-mcp",
  "version": "1.0.0",
  "description": "MCP server for Imhotep App Builder — work with Imhotep Projects, Releases, and Stories from any MCP client, as the authenticated Salesforce user.",
  "type": "module",
  "bin": {
    "imhotep-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "config.default.json",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imhotep",
    "salesforce",
    "agentforce",
    "claude"
  ],
  "author": "Mitch Lynch <mitch.lynch@salesforce.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jsforce": "^3.10.19",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.3.0",
    "turndown": "^7.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.0"
  }
}
